// akibase - comprehensive test suite
// Compile with: akic --test akibase_test.aki -o akibase_test
// Tests all modules that are part of the akibase library.

// ── Imports (bare imports for library modules with internal deps) ────

import "mem.aki";
import "arch.aki";
import "tristate.aki";
import "version.aki";
import "check.aki";
import "expected.aki";
import "endianess.aki";
import "numeric_limits.aki";
import "math/value_bounds.aki";
import "math/alignment.aki";
import "math/vec.aki";
import "hashing/fnv1a.aki";
import "hashing/djb2.aki";
import "hashing/joaat.aki";
import "hashing/elf.aki";
import "hashing/crc.aki";
import "algorithm.aki";
import "containers/pair.aki";
import "containers/span.aki";
import "containers/ring_buffer.aki";
import "containers/linked_list.aki";
import "containers/bitset.aki";

// ════════════════════════════════════════════════════════════════════
// Version
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_version_key() {
    let key = make_version_key(1, 2, 3);
    assert_eq(key as i32, 10203);
}

#[test]
fn test_version_extract() {
    let key = make_version_key(5, 12, 7);
    assert_eq(version_major(key) as i32, 5);
    assert_eq(version_minor(key) as i32, 12);
    assert_eq(version_patch(key) as i32, 7);
}

// ════════════════════════════════════════════════════════════════════
// TriState
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_tristate_failed() {
    assert_true(tri_failed(TriState::Unknown), "Unknown is failed");
    assert_true(tri_failed(TriState::False), "False is failed");
    assert_false(tri_failed(TriState::True), "True is not failed");
}

#[test]
fn test_tristate_true() {
    assert_true(tri_is_true(TriState::True), "True is true");
    assert_false(tri_is_true(TriState::False), "False is not true");
}

// ════════════════════════════════════════════════════════════════════
// Math - value_bounds
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_min_max() {
    assert_eq(min(3, 7), 3);
    assert_eq(min(10, 2), 2);
    assert_eq(max(3, 7), 7);
    assert_eq(max(10, 2), 10);
}

#[test]
fn test_clamp() {
    assert_eq(clamp(5, 0, 10), 5);
    assert_eq(clamp(-5, 0, 10), 0);
    assert_eq(clamp(15, 0, 10), 10);
}

#[test]
fn test_abs() {
    assert_eq(abs_i32(5), 5);
    assert_eq(abs_i32(-5), 5);
    assert_eq(abs_i32(0), 0);
}

// ════════════════════════════════════════════════════════════════════
// Math - alignment
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_align() {
    assert_eq(align(69, 1024) as i32, 1024);
    assert_eq(align(1024, 1024) as i32, 1024);
    assert_eq(align(1, 16) as i32, 16);
    assert_eq(align(17, 16) as i32, 32);
}

#[test]
fn test_align_skew() {
    assert_eq(align_skew(69, 1024, 1) as i32, 1025);
}

#[test]
fn test_is_aligned() {
    assert_true(is_aligned(4, 16), "16 aligned to 4");
    assert_false(is_aligned(8, 15), "15 not aligned to 8");
}

#[test]
fn test_is_power_of_2() {
    assert_true(is_power_of_2(1), "1");
    assert_true(is_power_of_2(2), "2");
    assert_true(is_power_of_2(1024), "1024");
    assert_false(is_power_of_2(0), "0");
    assert_false(is_power_of_2(3), "3");
}

#[test]
fn test_log2() {
    assert_eq(log2(1) as i32, 0);
    assert_eq(log2(2) as i32, 1);
    assert_eq(log2(1024) as i32, 10);
}

// ════════════════════════════════════════════════════════════════════
// Math - vec
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_vec2() {
    let v = Vec2<i32>(3, 4);
    assert_eq(v.a, 3);
    assert_eq(v.b, 4);
}

#[test]
fn test_vec3() {
    let v = Vec3<i32>(1, 2, 3);
    assert_eq(v.a, 1);
    assert_eq(v.c, 3);
}

#[test]
fn test_vec4() {
    let v = Vec4<i32>(10, 20, 30, 40);
    assert_eq(v.a, 10);
    assert_eq(v.d, 40);
}

// ════════════════════════════════════════════════════════════════════
// Hashing
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_fnv1a_32() {
    assert_eq(fnv1a_32("hello") as i32, fnv1a_32("hello") as i32);
    assert_ne(fnv1a_32("hello") as i32, fnv1a_32("world") as i32);
}

#[test]
fn test_fnv1a_64() {
    let h1 = fnv1a_64("test");
    let h2 = fnv1a_64("test");
    assert_true(h1 == h2, "fnv1a_64 deterministic");
}

#[test]
fn test_djb2() {
    assert_eq(djb2_32("hello") as i32, djb2_32("hello") as i32);
}

#[test]
fn test_joaat() {
    assert_eq(joaat_32("hello") as i32, joaat_32("hello") as i32);
    assert_ne(joaat_32("hello") as i32, joaat_32("world") as i32);
}

#[test]
fn test_elf_hash() {
    assert_eq(elf_hash("hello") as i32, elf_hash("hello") as i32);
    assert_ne(elf_hash("hello") as i32, elf_hash("world") as i32);
}

#[test]
fn test_crc32() {
    assert_eq(crc32("hello") as i32, crc32("hello") as i32);
    assert_ne(crc32("hello") as i32, crc32("world") as i32);
}

#[test]
fn test_crc32c() {
    assert_eq(crc32c("test") as i32, crc32c("test") as i32);
}

// ════════════════════════════════════════════════════════════════════
// Algorithms
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_sort() {
    var arr: [i32, 8] = {5, 3, 8, 1, 9, 2, 7, 4};
    sort_i32(&arr, 8);
    assert_eq(arr[0], 1);
    assert_eq(arr[1], 2);
    assert_eq(arr[7], 9);
}

#[test]
fn test_find() {
    var arr: [i32, 5] = {10, 20, 30, 40, 50};
    assert_eq(find_i32(&arr, 5, 30), 2);
    assert_eq(find_i32(&arr, 5, 99), -1);
}

#[test]
fn test_count() {
    var arr: [i32, 6] = {1, 2, 1, 3, 1, 4};
    assert_eq(count_i32(&arr, 6, 1), 3);
}

#[test]
fn test_reverse() {
    var arr: [i32, 4] = {1, 2, 3, 4};
    reverse_i32(&arr, 4);
    assert_eq(arr[0], 4);
    assert_eq(arr[3], 1);
}

#[test]
fn test_fill() {
    var arr: [i32, 3] = {0, 0, 0};
    fill_i32(&arr, 3, 42);
    assert_eq(arr[0], 42);
    assert_eq(arr[2], 42);
}

#[test]
fn test_iota() {
    var arr: [i32, 5] = {0, 0, 0, 0, 0};
    iota_i32(&arr, 5, 10);
    assert_eq(arr[0], 10);
    assert_eq(arr[4], 14);
}

#[test]
fn test_accumulate() {
    var arr: [i32, 4] = {1, 2, 3, 4};
    assert_eq(accumulate_i32(&arr, 4, 0), 10);
}

#[test]
fn test_lower_bound() {
    var arr: [i32, 5] = {1, 3, 5, 7, 9};
    assert_eq(lower_bound_i32(&arr, 5, 5), 2);
    assert_eq(lower_bound_i32(&arr, 5, 6), 3);
}

// ════════════════════════════════════════════════════════════════════
// Containers - Pair
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_pair_generic() {
    let p = Pair<i32>(10, 20);
    assert_eq(p.get_first(), 10);
    assert_eq(p.get_second(), 20);
}

#[test]
fn test_pair_i32() {
    let p = PairI32(42, 99);
    assert_eq(p.first, 42);
    assert_eq(p.second, 99);
}

// ════════════════════════════════════════════════════════════════════
// Containers - Span
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_span() {
    var arr: [i32, 5] = {10, 20, 30, 40, 50};
    let s = Span<i32>(&arr, 5);
    assert_eq(s.size(), 5);
    assert_false(s.empty(), "not empty");
    assert_eq(s.get(0), 10);
    assert_eq(s.get(4), 50);
    assert_eq(s.front(), 10);
    assert_eq(s.back(), 50);
}

// ════════════════════════════════════════════════════════════════════
// Containers - Ring Buffer
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_ring_buffer() {
    let rb = rb_new(4);
    assert_eq(rb_capacity(rb), 4);
    rb_save(rb, 100);
    rb_save(rb, 200);
    rb_save(rb, 300);
    assert_eq(rb_read(rb, 1), 100);
    assert_eq(rb_read(rb, 2), 200);
    assert_eq(rb_read(rb, 3), 300);
    rb_free(rb);
}

// ════════════════════════════════════════════════════════════════════
// Containers - Linked List
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_linked_list() {
    let list = ll_new();
    assert_true(ll_empty(list), "new list empty");
    ll_append(list, 10);
    ll_append(list, 20);
    ll_append(list, 30);
    assert_eq(ll_count(list), 3);

    var node = ll_head(list);
    assert_eq(ll_node_value(node), 10);
    node = ll_next(node);
    assert_eq(ll_node_value(node), 20);
    node = ll_next(node);
    assert_eq(ll_node_value(node), 30);
    ll_free(list);
}

#[test]
fn test_ll_prepend_pop() {
    let list = ll_new();
    ll_append(list, 2);
    ll_append(list, 3);
    ll_prepend(list, 1);
    assert_eq(ll_pop_front(list), 1);
    assert_eq(ll_pop_back(list), 3);
    assert_eq(ll_count(list), 1);
    ll_free(list);
}

// ════════════════════════════════════════════════════════════════════
// Containers - Bitset
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_bitset() {
    var bits = bs_new();
    bits = bs_set(bits, 3);
    bits = bs_set(bits, 7);
    assert_true(bs_test(bits, 3), "bit 3");
    assert_true(bs_test(bits, 7), "bit 7");
    assert_false(bs_test(bits, 0), "not bit 0");
    assert_eq(bs_count(bits), 2);
}

#[test]
fn test_bitset_ops() {
    let a = bs_set(bs_set(bs_new(), 0), 1);
    let b = bs_set(bs_set(bs_new(), 1), 2);
    assert_true(bs_test(bs_and(a, b), 1), "AND bit 1");
    assert_false(bs_test(bs_and(a, b), 0), "AND not bit 0");
    assert_eq(bs_count(bs_or(a, b)), 3);
}

// ════════════════════════════════════════════════════════════════════
// Expected
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_expected_ok() {
    let e = Expected<i32>(42);
    assert_false(e.has_error(), "no error");
    assert_eq(e.value(), 42);
}

#[test]
fn test_expected_err() {
    var e = Expected<i32>(0);
    e.set_error(-1);
    assert_true(e.has_error(), "has error");
    assert_eq(e.error(), -1);
}

// ════════════════════════════════════════════════════════════════════
// Check
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_dcheck() {
    dcheck!(true, "should pass");
    dcheck!(1 == 1, "equality");
    bugcheck!(true, "should pass");
}

// ════════════════════════════════════════════════════════════════════
// Endianness
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_byte_swap_16() {
    // 0x0102 -> 0x0201
    let swapped = byte_swap_16(258);  // 0x0102
    assert_eq(swapped as i32, 513);   // 0x0201
}

#[test]
fn test_byte_swap_32() {
    // 0x01020304 -> 0x04030201
    let swapped = byte_swap_32(16909060);  // 0x01020304
    assert_eq(swapped as i32, 67305985);   // 0x04030201
}

#[test]
fn test_byte_swap_roundtrip() {
    let original: u32 = 12345678;
    let double_swap = byte_swap_32(byte_swap_32(original));
    assert_eq(double_swap as i32, original as i32);
}

// ════════════════════════════════════════════════════════════════════
// Numeric Limits (const)
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_numeric_limits_i32() {
    assert_eq(I32_MIN, -2147483648);
    assert_eq(I32_MAX, 2147483647);
}

#[test]
fn test_numeric_limits_u8() {
    assert_eq(U8_MAX as i32, 255);
}

// ════════════════════════════════════════════════════════════════════
// Native byte type
// ════════════════════════════════════════════════════════════════════

#[test]
fn test_byte_type() {
    let b: byte = 42;
    assert_eq(b as i32, 42);
    let b2: byte = 255;
    assert_eq(b2 as i32, 255);
}

fn main() {
    println("akibase test suite — compile with --test to run all tests");
}
