// Version key encoding/decoding - aki equivalent of base/version.h
// Encodes version components into a single integer using base-100 digits.
// Uses variadic for-each to accept any number of components.

module version;

pub fn make_version_key(parts...): u64 {
    var res: u64 = 0;
    for (p in parts) { res = res * 100 + p % 100; }
    return res;
}

pub fn version_major(key: u64): u64 {
    return key / 10000;
}

pub fn version_minor(key: u64): u64 {
    return (key / 100) % 100;
}

pub fn version_patch(key: u64): u64 {
    return key % 100;
}
