// Numeric limit constants - aki equivalent of base/numeric_limits.h

module numeric_limits;

// u8
const U8_MIN = 0;
const U8_MAX = 255;
const U8_DIGITS = 8;

// i8
const I8_MIN = -128;
const I8_MAX = 127;
const I8_DIGITS = 7;

// u16
const U16_MIN = 0;
const U16_MAX = 65535;
const U16_DIGITS = 16;

// i16
const I16_MIN = -32768;
const I16_MAX = 32767;
const I16_DIGITS = 15;

// u32
const U32_MIN = 0;
const U32_MAX = 4294967295;
const U32_DIGITS = 32;

// i32
const I32_MIN = -2147483648;
const I32_MAX = 2147483647;
const I32_DIGITS = 31;

// u64
const U64_MIN = 0;
const U64_MAX = 18446744073709551615;
const U64_DIGITS = 64;

// i64
const I64_MAX = 9223372036854775807;
const I64_MIN = -9223372036854775807 - 1;
const I64_DIGITS = 63;
